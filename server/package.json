{
  "name": "@pomelo/server",
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node20 --minify --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "nodemon index.js",
    "test": "node --require ts-node/register/transpile-only --test \"tests/**/*.test.js\" \"tests/**/*.test.ts\"",
    "test:integration": "node --require ts-node/register/transpile-only --test tests/feedback.integration.ts",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@pomelo/code-gen": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jose": "^6.2.3",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "zod": "^4.3.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
