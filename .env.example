# Development environment (`pnpm dev`): the one file read by the server, client and admin
# daemon. Production installs use the app.env that pomelod generates instead.

# Session signing key for NextAuth. This value is for local development ONLY.
# For any real deployment, generate your own: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-do-not-use-in-production
# --- BACKEND SERVER CONFIG ---
PORT=8080
MONGODB_URI=mongodb://localhost:27017/pomelo
CITRON_URL=http://localhost:2358

# --- CLIENT CONFIG ---
DOMAIN=localhost:3000
PROTOCOL=http
BACKEND_URL=http://localhost:8080


# --- AUTHENTICATION (in production, pomelod sets AUTH_PROVIDERS from config.yaml `auth.providers`) ---
# Comma-separated enabled sign-in methods: credentials, google
AUTH_PROVIDERS=credentials
# Redirect URI to register in Google Cloud Console: <PROTOCOL>://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
