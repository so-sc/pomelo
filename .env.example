# Environment Variables Example For Docker

# --- SHARED SECRETS (Server & Client Server-Side) ---
AUTH_SECRET=xyz

# --- BACKEND SERVER CONFIG ---
PORT=8080
MONGODB_URI=mongodb://mongo:27017/pomelo
CITRON_URL=http://citron:2358

# --- CLIENT CONFIG ---
DOMAIN=localhost:3000
PROTOCOL=http
BACKEND_URL=http://localhost:8080


# --- AUTHENTICATION (in production, pomelod sets the AUTH_* toggles from config.yaml `auth:`) ---
AUTH_CREDENTIALS_ENABLED=true
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ALLOWED_DOMAINS=
# Redirect URI to register in Google Cloud Console: <PROTOCOL>://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
